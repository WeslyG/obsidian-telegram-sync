{
	"compilerOptions": {
		"noEmit": true,
		"module": "preserve",
		"moduleResolution": "bundler",
		"target": "ES2022",
		"allowJs": true,
		"strict": false,
		"noImplicitAny": true,
		"isolatedModules": true,
		"strictNullChecks": true,
		"lib": ["DOM", "ES2022"],
		"types": ["node"],
		"resolveJsonModule": true,
		"paths": {
			"src/*": ["./src/*"],
			"release-notes.mjs": ["./release-notes.mjs"]
		},
		"skipLibCheck": true,
		"noUnusedLocals": true
	},
	"include": ["src/**/*.ts"]
}
