{
	"name": "obsidian-telegram-sync",
	"version": "4.0.0",
	"private": true,
	"description": "Transfer messages and files from Telegram bot to Obsidian.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"lint": "oxlint --deny-warnings --report-unused-disable-directives",
		"lint-fix": "oxlint --fix",
		"typecheck": "tsc",
		"check": "npm run typecheck && npm run lint && npm test && npm run release-notes-check",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"test": "node --test",
		"test:install": "node esbuild.config.mjs test && node install-plugin.mjs",
		"release-notes-check": "node scripts/check-release.mjs",
		"build": "npm run check && node esbuild.config.mjs production && node scripts/check-bundle.mjs"
	},
	"engines": {
		"node": "24.x"
	},
	"overrides": {
		"@cypress/request": {
			"qs": "^6.16.1",
			"uuid": "^11.1.1"
		},
		"request-promise-core": {
			"request": {
				".": "npm:@cypress/request@3.0.10",
				"qs": "^6.16.1",
				"uuid": "^11.1.1"
			}
		}
	},
	"keywords": [
		"Telegram",
		"Syncing",
		"Messages",
		"Transfer Files"
	],
	"author": "soberhacker",
	"license": "GNU Affero General Public License v3.0",
	"devDependencies": {
		"@types/mime-types": "^3.0.1",
		"@types/node": "^24.19.2",
		"@types/qrcode": "^1.5.6",
		"@types/request": "^2.48.13",
		"esbuild": "^0.28.2",
		"obsidian": "^1.14.4",
		"oxlint": "^1.93.0",
		"prettier": "^3.9.10",
		"typescript": "^7.0.2"
	},
	"dependencies": {
		"@popperjs/core": "^2.11.7",
		"agent-base": "^7.1.4",
		"compare-versions": "^6.1.1",
		"https-proxy-agent": "^7.0.6",
		"linkify-it": "^6.1.0",
		"mime-types": "^3.0.2",
		"node-machine-id": "^1.1.12",
		"node-telegram-bot-api": "^0.67.0",
		"qrcode": "^1.5.4",
		"socks": "^2.8.10",
		"telegram": "^2.26.22"
	}
}
